# Live mode is the default. Set to demo to open on the sample-data version of the same page.
VITE_DATA_MODE=live

# Public Supabase project configuration (not passwords or service-role keys).
# Each source has its own sign-in and row-level access policies.
VITE_RENTSTREAM_URL=https://YOUR_RENTSTREAM_PROJECT.supabase.co
VITE_RENTSTREAM_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_STOCKSTREAM_URL=https://YOUR_STOCKSTREAM_PROJECT.supabase.co
VITE_STOCKSTREAM_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Assistant (server-side only; no VITE_ prefix, never sent to the browser).
# Without ANTHROPIC_API_KEY it uses a local Ollama model; figures stay on this Mac.
# ASSISTANT_PROVIDER=ollama        # or: anthropic
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=16384
# ANTHROPIC_API_KEY=

# Permanent connection (server-side only; no sign-in on the page).
# Supabase dashboard → Project Settings → API Keys → Secret keys. Read-only use.
# RENTSTREAM_SECRET_KEY=sb_secret_...
# STOCKSTREAM_SECRET_KEY=sb_secret_...
